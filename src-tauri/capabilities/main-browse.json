{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-browse",
  "description": "Local browsing, navigation, workspace preferences, and organization commands in native workspace windows.",
  "windows": ["main", "workspace-*"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-browse",
    "allow-cancel-browse",
    "allow-load-workspace",
    "allow-save-workspace",
    "allow-save-startup",
    "allow-open-workspace-window",
    "allow-close-workspace-window",
    "allow-load-workspace-views",
    "allow-save-workspace-view",
    "allow-load-workspace-controls",
    "allow-save-workspace-controls",
    "allow-load-organization",
    "allow-lookup-organization-tags",
    "allow-update-organization",
    "allow-mutate-file",
    "allow-trash-files",
    "allow-extract-zip-here",
    "allow-inspect-zip",
    "allow-compress-entry-zip",
    "allow-prepare-permanent-deletion",
    "allow-permanently-delete-files",
    "allow-file-undo-available",
    "allow-undo-last-file-action",
    "allow-copy-regular-file",
    "allow-copy-directory",
    "allow-recover-copy-transfer",
    "allow-prepare-file-replacement",
    "allow-replace-regular-file",
    "allow-stop-copy",
    "allow-has-window-transfers",
    "allow-stop-window-transfers",
    "allow-start-transfer",
    "allow-list-transfers",
    "allow-decide-transfer",
    "allow-stop-transfer",
    "allow-move-file-or-directory"
  ]
}
